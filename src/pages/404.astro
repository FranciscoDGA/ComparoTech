---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada" description="A página que você procura não existe ou foi movida.">
  <div class="container-narrow">
    <header class="page-header">
      <h1>404 — Página não encontrada</h1>
      <p>O endereço que você abriu não existe ou foi movido.</p>
    </header>
    <div class="page-body">
      <p>
        Volte para a <a href="/">página inicial</a> ou navegue pelas
        <a href="/">categorias</a> para encontrar o comparativo que procura.
      </p>
    </div>
  </div>
</Base>
