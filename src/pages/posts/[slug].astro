---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, categoryName } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, category, author, tags } = post.data;

const dateFormatted = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const updatedFormatted = updatedDate?.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === category)
  .slice(0, 3);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryName(category),
      item: `${SITE.url}/categorias/${category}`,
    },
    { '@type': 'ListItem', position: 3, name: title, item: `${SITE.url}/posts/${post.id}` },
  ],
};
---

<Base
  title={title}
  description={description}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article>
    <header class="article-header">
      <div class="container-narrow">
        <nav class="breadcrumb" aria-label="Navegação estrutural">
          <a href="/">Início</a>
          {' / '}
          <a href={`/categorias/${category}`}>{categoryName(category)}</a>
          {' / '}
          <span>{title}</span>
        </nav>
        <h1>{title}</h1>
        <div class="article-meta">
          <time datetime={pubDate.toISOString()}>Publicado em {dateFormatted}</time>
          {updatedFormatted && <span>· Atualizado em {updatedFormatted}</span>}
          <span>· Por {author}</span>
        </div>
      </div>
    </header>

    <div class="container-narrow">
      <AdSlot slot="post-topo" minHeight={90} />
    </div>

    <div class="container-narrow article-body">
      <Content />

      <div class="disclosure">
        Transparência: este artigo pode conter links de afiliados. Se você
        comprar por eles, o ComparoTech recebe uma comissão — sem custo extra
        para você. A recomendação segue a análise técnica, nunca a comissão.
      </div>

      <div class="author-box">
        <div class="author-avatar" aria-hidden="true">CT</div>
        <p>
          <strong>{author}</strong>
          Equipe de entusiastas de tecnologia do ComparoTech. Fazemos análises
          comparativas com base em planos oficiais, documentação e experiência de
          uso — sem enrolação.
        </p>
      </div>
    </div>

    <div class="container-narrow">
      <AdSlot slot="post-rodape" minHeight={120} />
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section-title">Artigos relacionados</h2>
          <div class="post-grid">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
