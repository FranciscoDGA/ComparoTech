---
import { SITE } from '../config';

const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Início' },
  { href: '/categorias/vpn-e-seguranca', label: 'VPN' },
  { href: '/categorias/hospedagem', label: 'Hospedagem' },
  { href: '/categorias/produtividade', label: 'Produtividade' },
  { href: '/categorias/apps-gratuitos', label: 'Apps' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/contato', label: 'Contato' },
];

function isCurrent(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="container">
    <a href="/" class="logo" aria-label={`${SITE.name} — página inicial`}>
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M4 17 L9.5 7 L13 13.5 L16 9 L20 17"
            stroke="#ffffff"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="20" cy="8" r="2" fill="#93c5fd"></circle>
        </svg>
      </span>
      Comparo<span>Tech</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label">Menu</label>

    <nav class="nav-main" aria-label="Menu principal">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
